# Cross-hospital imaging router — environment variable template
# Copy to .env and fill in. 全部凭据据从环境变量读，源码不硬编码。

# ---------- Database ----------
# PostgreSQL JDBC URL。默认占位为本机空启，需在本地 docker / psql 自建。
DATABASE_URL=jdbc:postgresql://localhost:5432/imaging_router
DATABASE_USER=imaging
DATABASE_PASSWORD=change_me

# ---------- 外院 PACS 准入配置 ----------
# JSON 数组。落地路径在 DICOM_PEERS_JSON_PATH；或经 /api/imaging/peers API 录入。
DICOM_PEERS_JSON_PATH=./config/peers.json
DICOM_TLS_PROTOCOLS=TLSv1.3,TLSv1.2
DICOM_TLS_CIPHER_SUITES=

# 本地 AE Title（DIMSE 端点 + DICOM Storage SCP）
LOCAL_AET=IMAGER
LOCAL_AET_HOST=127.0.0.1
LOCAL_AET_PORT=11112

# ---------- WADO-RS ----------
# 外院 WADO-RS 拉取 URL 模板，{studyUid} 会被替换。
WADO_RS_URL_TEMPLATE=http://127.0.0.1:8081/wado/studies/{studyUid}
WADO_RS_BEARER_TOKEN=

# ---------- 本院 PACS 写入目标 ----------
LOCAL_PACS_HOST=127.0.0.1
LOCAL_PACS_PORT=11113
LOCAL_PACS_AET=LOCAL_PACS

# ---------- HL7 v2.x MLLP 守护 ----------
# 监听端口（本院 HIS 把 ORM^O01 触发消息发到这里）；0 = 由内核分配空闲端口，仅用于本地试跑
HL7_TRIGGER_PORT=6661
# 监听地址；全网卡便于 HIS 从任意院内网段接入
HL7_TRIGGER_BIND_HOST=0.0.0.0
# 单帧 payload 上限（字节）；超限直接拒收并回 NAK，不做截断
HL7_MAX_FRAME_BYTES=4194304
# 读空闲阈值（毫秒），仅告警；配合 HL7_CLOSE_ON_IDLE 决定是否断连
HL7_IDLE_TIMEOUT_MS=30000
# MLLP 触发连接常被 HIS 长连复用，默认空闲只告警不断连；院内防火墙清理长连接时置 true
HL7_CLOSE_ON_IDLE=false
# Netty worker 线程数；0 = 按 CPU 核数 ×2
HL7_WORKER_THREADS=0
HL7_BACKLOG=128
# 报文编码。国内 HIS 常见 GBK，国标 HL7 要求 UTF-8，接入前务必与 HIS 侧对齐
HL7_CHARSET=UTF-8
# MLLP 释放模式：MLLP2 = 收帧回 ACK（院内常规）；MLLP1 = 不回 ACK
HL7_MLLP_RELEASE_MODE=MLLP2
# 本方 HL7 应用名 / 设施（MSH-3 / MSH-4），与 DICOM AET 同为 16 字符上限
HL7_LOCAL_APPLICATION=IMAGER
HL7_LOCAL_FACILITY=LOCAL_HOSP
# HL7 触发报文死信告警 webhook（钉钉 / 企业微信 / 院内自建告警网关均可）。
# 留空 = 死信只落库不推告警；死信表本身照常写。
HL7_DEADLETTER_ALERT_WEBHOOK_URL=
# 告警投递超时（毫秒）；告警走独立线程，不占 Netty 事件循环
HL7_DEADLETTER_ALERT_TIMEOUT_MS=3000

# ---------- HIS 结果回调 ----------
HIS_WEBHOOK_URL=
HIS_WEBHOOK_TIMEOUT_MS=5000

# ---------- 死信告警 webhook ----------
# 调阅任务死信（重试耗尽 / 不可恢复失败）的告警外发地址。
# 留空 = 死信只落库不推告警；死信表本身照常写。
DLQ_ALERT_WEBHOOK_URL=
# 同一失败码的告警冷却窗口（分钟）：一次外院断网会产生几十条同码死信，
# 不做抑制的话值班手机会被同一件事震几十遍。
DLQ_ALERT_COOLDOWN_MINUTES=10
# 告警投递超时（毫秒）
DLQ_ALERT_TIMEOUT_MS=3000
# 已处置死信保留天数（未处置的死信永不自动清理）
DLQ_RETENTION_DAYS=30

# ---------- ModelGateway（OpenAI-compatible） ----------
# 留空时走规则模板兑底（source=rule_fallback）。不填也能启动服务，但 AI 介入点会走兑底路径。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
MODEL_TIMEOUT_MS=5000
# 模型不可达时是否回退规则模板（置 false 则不产出草稿，直接失败）
MODEL_FALLBACK_ENABLED=true
# 规则词典位置（模态映射 / 兜底文案 / 互认判据）—— 信息科可直接改这个文件
MODEL_FALLBACK_TEMPLATES_PATH=classpath:hl7/segment-mappings.yml
# 规则模板骨架位置（输出字段与渲染指令）
MODEL_FALLBACK_RULE_TEMPLATES_PATH=classpath:hl7/rule-templates.json

# ---------- 构建时间（CI 注入） ----------
BUILD_TIME=2026-10-20T00:00:00Z